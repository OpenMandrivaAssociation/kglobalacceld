--- kglobalacceld-pristine/src/kglobalaccel_platform.h	1970-01-01 01:00:00.000000000 +0100
+++ kglobalacceld/src/kglobalaccel_platform.h	2026-10-18 18:52:05.169995176 +0200
@@ -0,0 +1,71 @@
+/*
+    This file is part of the KDE libraries
+    SPDX-FileCopyrightText: 2015 Martin Gräßlin <mgraesslin@kde.org>
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#ifndef KGLOBALACCEL_PLATFORM_H
+#define KGLOBALACCEL_PLATFORM_H
+
+#include "kglobalacceld_export.h"
+
+#include <QByteArray>
+#include <QObject>
+
+class GlobalShortcutsRegistry;
+class KGlobalAccelD;
+
+#define KGlobalAccelPlatform_iid "org.kde.kglobalacceld.KGlobalAccelPlatform"
+
+/**
+ * X11 (and test) platform plugins implement grabKey().
+ * Key delivery goes through KGlobalAccelD, not this class: there is no
+ * KGlobalAccelInterface in 6.8.
+ *
+ * Not installed. Wayland KWin does not load a platform plugin and calls
+ * KGlobalAccelD::keyEvent() itself.
+ */
+class KGLOBALACCELD_EXPORT KGlobalAccelPlatform : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit KGlobalAccelPlatform(QObject *parent);
+    ~KGlobalAccelPlatform() override;
+
+    virtual bool grabKey(int key, bool grab) = 0;
+
+    void setRegistry(GlobalShortcutsRegistry *registry);
+    void setGlobalAccelD(KGlobalAccelD *globalAccel);
+
+protected:
+    void grabKeys();
+    void ungrabKeys();
+    KGlobalAccelD *globalAccel() const;
+
+private:
+    GlobalShortcutsRegistry *m_registry = nullptr;
+    KGlobalAccelD *m_globalAccel = nullptr;
+};
+
+Q_DECLARE_INTERFACE(KGlobalAccelPlatform, KGlobalAccelPlatform_iid)
+
+/**
+ * False on a Wayland session so the X11 grabber is not loaded inside KWin.
+ * XDG_SESSION_TYPE=x11 wins over a stray WAYLAND_DISPLAY.
+ * If the session type is missing, WAYLAND_DISPLAY means Wayland.
+ */
+inline bool kglobalaccelX11GrabAllowed()
+{
+    const QByteArray sessionType = qgetenv("XDG_SESSION_TYPE").toLower();
+    if (sessionType == "wayland") {
+        return false;
+    }
+    if (sessionType == "x11") {
+        return true;
+    }
+    return qgetenv("WAYLAND_DISPLAY").isEmpty();
+}
+
+#endif
